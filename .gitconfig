[user]
    name = Giorgio Mendieta
    email = 31053658+GiorgioMendieta@users.noreply.github.com
	signingkey = /Users/giorgio/.ssh/id_ed25519.pub

[include]
    # Delta diff viewer theme
    path = ~/.dotfiles/Apps/delta/themes.gitconfig

[init]
    defaultBranch = main

[color]
    ui = auto

[pretty]
	lo = tformat:%C(auto)%h%C(reset)%C(auto)%d%C(reset) %s %C(italic blue)%ad%C(reset) %C(241)%aN%C(reset)

[alias]
    # Inspired by https://github.com/alfunx/.dotfiles/blob/master/.gitconfig
    # Pretty log (default one is pretty bad)
    l = log --graph --date=relative --pretty=lo
    lr = log --graph --date=relative --pretty=lo -10 # log recent 10 commits

    # Commit
    cm  = commit -m
    ca  = commit --amend
	can = commit --amend --no-edit

    # rebase
	r  = rebase
	ra = rebase --abort
	rc = rebase --continue

    # cherry-pick
	cp  = cherry-pick
	cpa = cherry-pick --abort
	cpc = cherry-pick --continue
	cpq = cherry-pick --quit

    last-diff = diff HEAD~1 HEAD
    st = status -sb
    co = checkout
    su = submodule update --init --recursive
    d  = diff

    # show authors and and commit counts
	#    git thanks [<git-log-args>...]
	thanks = "!f() { git log --pretty=tformat:'%aN <%aE>' \"$@\" | sort | uniq -c | sort -rn; }; f"

    # Open GitHub repository in browser
    #    git open [<remote>]
    open = "!f() { \
        URL=$(git remote get-url \"${1:-origin}\") || return; \
        URL=${URL%.git}; \
        URL=${URL#git@github.com:}; \
        URL=\"${URL#https://github.com/}\"; \
        case \"$URL\" in */*) ;; *) echo \"Unsupported remote URL: $URL\" >&2; return 1 ;; esac; \
        open \"https://github.com/$URL\"; \
    }; f"

[core]
    excludesfile = ~/.gitignore_global
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    # cf. $DOTFILES/Apps/delta/themes.gitconfig for the list of available themes
    features = giorgio
    navigate = true
    line-numbers = true
    true-color = always

[merge]
    conflictstyle = zdiff3

[fetch]
    # Automatically remove remote tracking branches that no longer exist
    prune = true

[pull]
    rebase = true

[diff]
    colorMoved = default

[commit]
	gpgsign = true

[gpg]
	format = ssh

[push]
	autoSetupRemote = true
